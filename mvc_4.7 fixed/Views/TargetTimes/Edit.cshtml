@model ok1.Models.TargetTime

@{
    ViewBag.Title = "Target Time";
}

<h2>@ViewBag.Title</h2>
<hr />


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="default-form">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)

        <div class="form-container">
            <h4 class="text-decoration-underline">Employee Information</h4>
            <div class="form-grid">
                <div class="form-group">
                    <label>Badge ID:</label>
                    @Html.EditorFor(model => model.EmpBadgeId, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.EmpBadgeId, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Name:</label>
                    @Html.EditorFor(model => model.EmpName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.EmpName, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Department:</label>
                    @Html.EditorFor(model => model.EmpDept, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.EmpDept, "", new { @class = "text-danger" })
                </div>
            </div>

            <h4 class="text-decoration-underline">Shifts Information</h4>
            <div class="form-grid">
                <div class="form-group">
                    <label>Normal Shift:</label>
                    @Html.EditorFor(model => model.NormalShift, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.NormalShift, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Morning Shift:</label>
                    @Html.EditorFor(model => model.MorningShift, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.MorningShift, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Afternoon Shift:</label>
                    @Html.EditorFor(model => model.AfternoonShift, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.AfternoonShift, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Night Shift:</label>
                    @Html.EditorFor(model => model.NightShift, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.NightShift, "", new { @class = "text-danger" })
                </div>
            </div>

            <h4 class="text-decoration-underline">Area Information</h4>
            <div class="form-grid">
                <div class="form-group">
                    <label>Group Area :</label>
                    @Html.EditorFor(model => model.Group, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Group, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Detail Area :</label>
                    @Html.EditorFor(model => model.AreaDI, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.AreaDI, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Area : </label>
                    @Html.EditorFor(model => model.Area, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Area, "", new { @class = "text-danger" })
                </div>
            </div>


        </div>

        <div class="button-container">
            <input type="submit" value="Save changes" class="btn btn-primary" style="background-color: #0A8276; color: white;" />
            @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-back" })
        </div>
    </div>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
    //auto fill form
    $(document).ready(function () {
        $("#EmpBadgeId").on("change", function () {
            var empBadgeId = $(this).val();
            console.log("sending EmpBadgeId:", empBadgeId);
            if (empBadgeId) {
                $.ajax({
                    url: `/TargetTimes/GetEmpData?empBadgeId=` + empBadgeId,
                    type: `GET`,
                    data: { empBadgeId: empBadgeId },
                    success: function (data) {
                        console.log("Response:", data);
                        if (data) {
                            $('input[name="EmpName"]').val(data.EmpName);
                            $('input[name="EmpDept"]').val(data.EmpDept);
                            $('input[name="Group"]').val(data.Group);
                            $('input[name="AreaDI"]').val(data.AreaDI);
                            $('input[name="Area"]').val(data.Area);

                            // Log the values after setting them
                            console.log("Name input value after setting:", $('input[name="Name"]').val());
                            console.log("Department input value after setting:", $('input[name="Department"]').val())

                        } else {

                            console.log("No data received");
                        }

                    },
                    error: function () {
                        alert("Error fetching employee data");
                    }
                });
            }
        });
    });
    </script>

}
