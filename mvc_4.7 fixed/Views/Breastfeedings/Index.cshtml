@model PagedList.IPagedList<ok1.Models.Breastfeeding>
@using PagedList.Mvc;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text" />
@{
    ViewBag.Title = "Breastfeeding Mom";
}

@{
    var db = new ok1.Data.ok1Context();
    var windAcc = User.Identity.Name.ToLower();
    var isAdmin = db.Credentials.Any(c => c.WindAcc.ToLower() == windAcc && c.isAdmin);
}

<h2>@ViewBag.Title</h2>
<hr />
@*SEARCH SECTION*@
<div class="col-md-4">
    <div class="filter-container" style="padding: 15px; background-color: #f8f9fa; border-radius: 5px; margin-bottom: 20px;">
        <form method="get" asp-action="Index">
            <label>Search Badge ID :</label>
            @*DONE*@

            <input type="text" class="form-control" id="searchString" name="searchString" value="@ViewBag.SearchString" placeholder="Type Badge ID here" />
            <div class="button-container">
                <button type="submit" class="btn" style="align-self: flex-end; margin-left: auto; background-color: #0A8276; color: white;">Filter</button>
            </div>
        </form>
    </div>
</div>
<br />
@*TABEL SECTION*@
<div class="button-container">
    @Html.ActionLink(
        "Export Data",
        "ExportToExcel",
        "Breastfeedings",
        new { searchString = ViewBag.SearchString },
        new { @class = "btn", style = "margin-left:10px; background-color: #0A8276; color: white;" }
    )
    @Html.ActionLink("Create New", "Create", null, new { @class = "btn", style = "background-color: #0A8276; color: white;" })
    <!--<a href="@Url.Action("ExportToExcel", "Breastfeedings", new { searchString = ViewBag.SearchString })" class="btn btn-primary" style="margin-left:10px;">Export</a>-->
</div>

<div class="table-container mb-4">
    <p style="font-size:18px">
        <strong>Total Records:</strong> @Model.TotalItemCount
    </p>
    <table class="table table-bordered">
        <thead class="text-center" style="position: sticky; top: 0; background-color: #0A8276; color: white">
            <tr>
                <th>No</th>
                <th>Badge ID</th>
                <th>Name</th>
                <th>Date Of Birth</th>
                <th>Expired Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @{
                int no = (Model.PageNumber - 1) * Model.PageSize + 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@no</td>
                    <td>@item.EmpBadgeId</td>
                    <td>@item.EmpName</td>
                    <td>@item.DateOfBirth.ToString("yyyy-MM-dd")</td>
                    <td>@item.ExpDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.Status</td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn", style = "color: white; text-decoration: none; background-color: #0A8276;" })
                        @*                        @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger", style = "color: white; text-decoration: none;" })
                        *@
                        @if(isAdmin)
                        {
                            <button class="btn btn-danger btn-sm deletebtn" data-id="@item.Id">Delete</button>
                        }
                        

                    </td>
                </tr>
                no++;
            }
    </table>
</div>

<div class="pagination">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
            $(document).ready(function () {
            // Attach the click event to elements with the class 'deletebtn'
            $(document).on('click', '.deletebtn', function () {
                var eventId = parseInt($(this).data('id'), 10); // Get the Event ID
                var row = $(this).closest('tr'); // Get the row containing the button
                console.log("Event ID: ", eventId, typeof eventId);

                // Validate the event ID
                if (!eventId || isNaN(eventId)) {
                    alert("Cannot delete: Invalid event ID.");
                    return;
                }

                // Confirm deletion
                if (confirm("Are you sure you want to delete this?")) {
                    // Make the AJAX request
                    $.ajax({
                        url: '@Url.Action("DeleteBusui", "Breastfeedings")', // URL for deletion
                        type: 'POST',/*
                        headers: {
                            "RequestVerificationToken": $('input[name="RequestVerificationToken"]').val() // CSRF token
                        }*/
                        contentType: "application/json;charset=UTF-8",
                        dataType: "json",
                        data: JSON.stringify({ id: eventId }), // Send the event ID to the server
                        success: function (response) {
                            console.log("Response from delete: ", response);

                            // Check if the response indicates success
                            if (response.success) {
                                // Fade out and remove the row
                                row.fadeOut(300, function () {
                                    $(this).remove();
                                });
                            } else {
                                // Show error message from the server
                                alert(response.message || "Failed to delete the data.");
                            }
                        },
                        error: function (xhr, status, error) {
                            // Log and display error information
                            console.error("AJAX error: ", status, error, xhr.responseText);
                            alert("An error occurred while deleting the data: " + (xhr.responseText || "Please try again."));
                        }
                    });
                }
            });
        });

    </script>
}