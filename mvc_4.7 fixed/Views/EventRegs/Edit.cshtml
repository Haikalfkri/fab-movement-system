
@model ok1.Models.EventReg

@{
    ViewBag.Title = "Event Registration";
    var recordedBadgeIds = Model.EventAttendees.Select(ea => ea.Attendee.EmpBadgeId).ToList() ?? new List<string>();
}

<h2>@ViewBag.Title</h2>
<hr />


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
   <div id="autosave-toast" style="
        display:none;
        position:fixed;
        top:30px;
        right:30px;
        z-index:9999;
        background:#3B9B91;
        color:#fff;
        padding:16px 32px;
        border-radius:6px;
        box-shadow:0 2px 8px rgba(0,0,0,0.15);
        font-size:16px;
        font-weight:bold;
        opacity:0.95;
        transition: opacity 0.3s;
    ">
        Save successfully!
    </div>

    <div class="default-form">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)

        <h4 class="text-decoration-underline">Trainer Information</h4>
        <div class="form-grid">
            <div class="form-group">
                <label>Trainer Id :</label>
                @Html.EditorFor(model => model.TrainerId, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.TrainerId, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label>Trainer Name :</label>
                @Html.EditorFor(model => model.TrainerName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.TrainerName, "", new { @class = "text-danger" })
            </div>
        </div>

        <h4 class="text-decoration-underline">Event Information</h4>
        <div class="form-grid">
            <div class="form-group">
                <label>Event Date :</label>
                @Html.TextBoxFor(model => model.EventDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", @id = "EventDate" })
                @Html.ValidationMessageFor(model => model.EventDate, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label>Event Name :</label>
                @Html.EditorFor(model => model.EventName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.EventName, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label>Start Time :</label>
                @Html.EditorFor(model => model.StartTime, new { htmlAttributes = new { @class = "form-control", type = "time", @id = "StartTime" } })
                @Html.ValidationMessageFor(model => model.StartTime, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>End Time :</label>
                @Html.EditorFor(model => model.EndTime, new { htmlAttributes = new { @class = "form-control", type = "time", @id = "EndTime" } })
                @Html.ValidationMessageFor(model => model.EndTime, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Event Duration :</label>
                @Html.EditorFor(model => model.EventDur, new { htmlAttributes = new { @class = "form-control", @id = "EventDur" } })
                @Html.ValidationMessageFor(model => model.EventDur, "", new { @class = "text-danger" })
            </div>
        </div>

        <h4 class="text-decoration-underline">Add More Participant</h4>
        <div id="participantContainer">
            <div class="participant-row">
                <table class="table table-bordered">
                    <thead class="text-center">
                        <tr>
                            <th>Badge ID</th>
                            <th>Name</th>
                            <th>Department</th>
                        </tr>
                    </thead>
                    <tbody id="participantTableBody">
                        <tr class="participant-row">
                            <td>
                                <input type="text" name="EmpBadgeId[]" class="form-control" onblur="fetchUserData(this)" autocomplete="off" />
                            </td>
                            <td><input type="text" name="EmpName[]" class="form-control" /></td>
                            <td><input type="text" name="EmpDept[]" class="form-control" /></td>

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <br />
        <!--List Attendees-->
        <h4 class="text-decoration-underline">Recorded Participant </h4>
        <div id="List">
            @Html.Partial("_List", Model, new ViewDataDictionary { { "ShowDeleteButton", true } })
        </div>


        <div class="button-container">
            <input type="submit" value="Save changes" class="btn btn-primary" style="background-color: #0A8276; color: white;" />
            @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-back" })
        </div>
    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    // Make recorded badge IDs available to JS
    var recordedBadgeIds = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(recordedBadgeIds));

     //Auto Count Event Duration
    function countDuration() {
        let StartTime = document.getElementById("StartTime").value;
        let EndTime = document.getElementById("EndTime").value;
        let durationField = document.getElementById("EventDur");


        if (StartTime && EndTime) {
            //split hour and minutes
            let start = new Date(`1970-01-01T${StartTime}:00`);
            let end = new Date(`1970-01-01T${EndTime}:00`);

            if (end > start) {
                let diffMs = end - start;
                let diffHours = Math.floor(diffMs / (1000 * 60 * 60));
                let diffMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
                let diffSeconds = Math.floor((diffMs % (1000 * 60)) / 1000);

                let formattedDuration = [
                    diffHours.toString().padStart(2, '0'),
                    diffMinutes.toString().padStart(2, '0'),
                    diffSeconds.toString().padStart(2, '0')
                ].join(':');

                durationField.value = formattedDuration;

            } else {

                durationField.value = "Invalid duration";
            }
        }
    }
 document.getElementById("StartTime").addEventListener("change", countDuration);
 document.getElementById("EndTime").addEventListener("change", countDuration);

      //GET form participant list data
  function AutoRefresh() {
      $.get("@Url.Action("GetParticipantData", "EventRegs")", function (data) {
          //console.log("data :", GetParticipantData);
          $("#List").html(data);
      });
  };

    //AUTO FILL TRAINER
    $(document).ready(function () {
        // Attach change event to the #EmpBadgeId element
        $("#TrainerId").on("change", function () {
            var trainerId = $(this).val(); // Get the badge ID
            console.log("Sending EmpBadgeId:", trainerId);

            // Proceed only if the badge ID is valid (not empty)
            if (trainerId) {
                // Use Url.Action to dynamically generate the server endpoint
                var endpointUrl = '@Url.Action("GetTrainerData", "EventRegs")';

                // Make an AJAX GET request to fetch employee data
                $.ajax({
                    url: `${endpointUrl}?trainerId=${trainerId}`, // Append the badge ID as a query parameter
                    type: 'GET',
                    success: function (data) {
                        console.log("Response:", data);

                        // Check if data is returned
                        if (data) {
                            // Populate the input fields with the employee data
                            $('input[name="TrainerName"]').val(data.TrainerName);
                            // Log values for debugging
                            console.log("Name input value after setting:", $('input[name="TrainerName"]').val());
                        } else {
                            console.log("No data received or employee not found.");
                            alert("No data available for the provided Employee Badge ID.");
                        }
                    },
                    error: function (xhr, status, error) {
                        // Handle errors gracefully
                        console.error("Error fetching employee data:", status, error);
                        alert("Trainer Badge ID Not Found");
                    }
                });
            } else {
                console.log("No EmpBadgeId provided.");
                alert("Please enter a valid Employee Badge ID.");
            }
        });
    });

    function autoSaveParticipants() {
        // Gather all participant data
        let eventId = $('#EventId').val();
        let badgeIds = [];
        let names = [];
        let depts = [];
        $('#participantTableBody tr').each(function () {
            let badge = $(this).find('input[name="EmpBadgeId[]"]').val();
            let name = $(this).find('input[name="EmpName[]"]').val();
            let dept = $(this).find('input[name="EmpDept[]"]').val();
            if (badge && name && dept) {
                badgeIds.push(badge);
                names.push(name);
                depts.push(dept);
            }
        });

        // prepare event data
        let eventData = {
            Id: eventId,
            TrainerId: $('#TrainerId').val(),
            TrainerName: $('#TrainerName').val(),
            EventDate: $('#EventDate').val(),
            EventName: $('#EventName').val(),
            StartTime: $('#StartTime').val(),
            EndTime: $('#EndTime').val(),
            EventDur: $('#EventDur').val()
        }

        $.ajax({
            url: '@Url.Action("EditParticipantAutoSave", "EventRegs")',
            type: 'POST',
            data: {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                eventReg: eventData,
                EmpBadgeId: badgeIds,
                EmpName: names,
                EmpDept: depts
            },
            success: function (response) {
                if (response.success) {
                    // Update hidden eventId if new event created
                    $('#EventId').val(response.eventId);
                    showAutoSaveToast(response.message || "Auto-saved successfully!")
                } else {
                    alert("Auto-save failed: " + response.message);
                }
            },
            error: function () {
                alert("Error during autosave.")
            }
        });
    }

    function addParticipant() {
        let tbody = document.getElementById("participantTableBody");
        let lastRow = tbody.querySelector("tr:last-child");
        let inputs = lastRow.querySelectorAll("input");
        let allFilled = Array.from(inputs).every(input => input.value.trim() !== "");

        if (allFilled) {
            let row = document.createElement("tr");
            row.classList.add("participant-row");
            row.innerHTML = `
                <td>
                    <input type="text" name="EmpBadgeId[]" class="form-control" onblur="fetchUserData(this)" />
                </td>
                <td><input type="text" name="EmpName[]" class="form-control" /></td>
                <td><input type="text" name="EmpDept[]" class="form-control" /></td>
            `;

            tbody.appendChild(row);

            // Auto focus on the new badge ID input
            let newEmpBadgeInput = row.querySelector('input[name="EmpBadgeId[]"]');
            if (newEmpBadgeInput) {
                newEmpBadgeInput.focus();
            }
        }
    }

    function fetchUserData(input, isScanner = false) {
        let empId = input.value.trim();
        let row = input.closest('tr');

        // Check for duplicate in the add table
        let existingRows = document.querySelectorAll('input[name="EmpBadgeId[]"]');
        let isDuplicate = Array.from(existingRows).some(existingInput =>
            existingInput.value.trim() === empId && existingInput !== input
        );

        let isDuplicateRecorded = recordedBadgeIds.some(function (badgeId) {
            return badgeId.trim().toLowerCase() === empId.toLowerCase();
        })

        if (isDuplicate) {
            alert("This Employee Badge ID is already listed in the table.");
            input.value = '';
            row.querySelector('input[name="EmpName[]"]').value = '';
            row.querySelector('input[name="EmpDept[]"]').value = '';
            return; // <-- This return prevents further execution
        }

        if (isDuplicateRecorded) {
            alert("This Employee Badge ID already recorded to this event");
            input.value = '';
            row.querySelector('input[name="EmpName[]"]').value = '';
            row.querySelector('input[name="EmpDept[]"]').value = '';
            return; // <-- This return prevents further execution
        }

        if (empId) {
            let endpointUrl = '@Url.Action("GetParticipantData", "EventRegs")';

            $.ajax({
                url: `${endpointUrl}?empId=${empId}`,
                type: "GET",
                success: function (data) {
                    if (data) {
                        // Check for duplicate after AJAX fetch
                        let badgeId = data.EmpBadgeId || empId;
                        let isAlreadyInTable = Array.from(document.querySelectorAll('input[name="EmpBadgeId[]"]'))
                            .some(existingInput =>
                                existingInput.value.trim() == badgeId && existingInput !== input
                        )

                        if (isAlreadyInTable) {
                            alert("This Employee Badge ID is already listed in the table");
                            row.querySelector('input[name="EmpName[]"]').value = '';
                            row.querySelector('input[name="EmpDept[]"]').value = '';
                            return;
                        }
                    
                        row.querySelector('input[name="EmpName[]"]').value = data.EmpName;
                        row.querySelector('input[name="EmpDept[]"]').value = data.EmpDept;
                        addParticipant();
                        if (isScanner) {
                            addParticipant();
                        }
                        autoSaveParticipants();
                    } else {
                        alert("Badge ID Not Found");
                        input.value = '';
                        row.querySelector('input[name="EmpName[]"]').value = '';
                        row.querySelector('input[name="EmpDept[]"]').value = '';
                    }
                },
                error: function () {
                    alert("Badge ID Not Found");
                    input.value = '';
                    row.querySelector('input[name="EmpName[]"]').value = '';
                    row.querySelector('input[name="EmpDept[]"]').value = '';
                }
            });
        }
    }

    function showAutoSaveToast(message) {
        var toast = document.getElementById("autosave-toast");
        toast.textContent = message;
        toast.style.display = "block";
        toast.style.opacity = "0.95";
        // Hide after 1 seconds
        setTimeout(function () {
            toast.style.opacity = "0";
            setTimeout(function () {
                toast.style.display = "none";
            }, 300);
        }, 1000)
    }

    let scanTimeout;

    document.addEventListener('keydown', function (e) {
        let activeElement = document.activeElement;

        if (activeElement && activeElement.name === "EmpBadgeId[]" && e.key === "Enter") {
            e.preventDefault(); // Cegah aksi default

            // Gunakan debounce untuk mengatur jeda pemrosesan
            clearTimeout(scanTimeout);
            scanTimeout = setTimeout(() => {
                fetchUserData(activeElement, true);
            }, 300); // Sesuaikan waktu debounce sesuai kebutuhan
        }
    });

    // delete partial on page
    $(document).on('click', '.deletebtn', function (event) {
        event.preventDefault(); // Mencegah aksi default form atau navigasi

        var attendeeId = $(this).data('attendee-id');
        var eventId = $(this).data('event-id');
        var row = $(this).closest('tr');
        console.log("Attendee ID: ", attendeeId);
        console.log("Event ID: ", eventId);

        if (confirm("Are you sure you want to delete this user?")) {
            $.ajax({
                url: '@Url.Action("DeleteAttendee", "EventRegs")',
                type: 'POST',
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                data: JSON.stringify({
                    attendeeId: attendeeId,
                    eventRegId: eventId
                }),
                success: function (response) {
                    console.log("Delete response: ", response);
                    if (response.success) {
                        row.fadeOut(300, function () {
                            $(this).remove(); // Hapus row dari tabel
                        });
                    } else {
                        alert(response.message || "Failed to delete user.");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error deleting attendee: ", xhr.responseText);
                    alert("An error occurred while deleting the attendee.");
                }
            });
        }
    });

</script>
}
