
@model PagedList.IPagedList<ok1.Models.PublicHoliday>
@using PagedList.Mvc;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />



@using (Html.BeginForm("Create", "PublicHolidays", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div id="PHsData" class="default-form">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-container">
            <div class="row mb-2">
                <div class="form-group">
                    <label>Start Date :</label>
                    <input type="date" name="DateFrom" id="DateFrom" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>Until : </label>
                    <input type="date" name="DateTo" id="DateTo" class="form-control" required />

                </div>

                <div class="form-group">
                    <label>Remark :</label>
                    <input type="text" name="RemarkDate" id="RemarkDate" class="form-control" required />
                </div>
                <div class="button-container">
                    <input type="submit" value="Create" class="btn btn-primary" style="background-color: #0A8276;" />
                </div>
            </div>
        </div>
    </div>
}
