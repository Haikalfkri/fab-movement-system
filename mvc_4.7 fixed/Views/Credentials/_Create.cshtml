@model List<ok1.Models.Credential>


@using (Html.BeginForm("Create", "Credentials", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="default-form">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-container">
            <div class="form-group">
                <label>Badge ID :</label>
                <input type="text" id="EmpBadgeId" name="EmpBadgeId" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Full Name :</label>
                <input type="text" id="EmpName" name="EmpName" class="form-control" />
            </div>

            <div class="form-group">
                <label>Windows Account : </label>
                <input type="text" id="WindAcc" name="WindAcc" class="form-control" />
            </div>
            <div class="form-group ">
                <label class="form-label">Grant Access Pages :</label>
                <div class="row">
                    @foreach (var page in ViewBag.AvailablePages as List<string>)
                    {
                        <div class="row-cols-md-2 ">
                            <div class="form-check">
                                <input type="checkbox" name="SelectedPages" value="@page" class="form-check-input" id="page_@page" />
                                <label class="form-check-label" for="page_@page">@page</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="button-container">
            <input type="submit" value="Create" class="btn btn-primary" style="background-color: #0A8276;"/>
        </div>
    </div>
    
}



