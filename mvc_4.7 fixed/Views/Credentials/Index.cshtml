    //form submit
    $('#CredentialsData form').submit(function (e) {
        e.preventDefault();
        var form = $(this);
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (result) {
                if (result.success) {
                    location.reload();
                } else {
                    var errors = result.errors || { General: 'An error occurred.' };
                    var errorMsg = Object.keys(errors).map(k => errors[k]).join('\n');
                    alert(errorMsg);
                }
            },
            error: function () {
                alert('Error submitting form.');
            }
        });
    });
/*DELETE ROW*/
        $(document).ready(function () {
            // Attach the click event to elements with the class 'deletebtn'
            $(document).on('click', '.deletebtn', function () {
                var eventId = parseInt($(this).data('id'), 10); // Get the Event ID
                var row = $(this).closest('tr'); // Get the row containing the button
                console.log("Event ID: ", eventId, typeof eventId);

                // Validate the event ID
                if (!eventId || isNaN(eventId)) {
                    alert("Cannot delete: Invalid event ID.");
                    return;
                }

                // Confirm deletion
                if (confirm("Are you sure you want to delete this?")) {
                    // Make the AJAX request
                    $.ajax({
                        url: '@Url.Action("DeleteCreds", "Credentials")', // URL for deletion
                        type: 'POST',/*
                        headers: {
                            "RequestVerificationToken": $('input[name="RequestVerificationToken"]').val() // CSRF token
                        }*/
                        contentType: "application/json;charset=UTF-8",
                        dataType: "json",
                        data: JSON.stringify({ id: eventId }), // Send the event ID to the server
                        success: function (response) {
                            console.log("Response from delete: ", response);

                            // Check if the response indicates success
                            if (response.success) {
                                // Fade out and remove the row
                                row.fadeOut(300, function () {
                                    $(this).remove();
                                });
                            } else {
                                // Show error message from the server
                                alert(response.message || "Failed to delete the data.");
                            }
                        },
                        error: function (xhr, status, error) {
                            // Log and display error information
                            console.error("AJAX error: ", status, error, xhr.responseText);
                            alert("An error occurred while deleting the data: " + (xhr.responseText || "Please try again."));
                        }
                    });
                }
            });
        });


    </script>
}