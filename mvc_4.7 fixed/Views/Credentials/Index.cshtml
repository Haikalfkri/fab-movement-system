
@model IEnumerable<ok1.Models.Credential>
@{
    ViewBag.Title = "Granted Access";
}
<h2>@ViewBag.Title</h2>
<hr />
<div id="CredentialsData">
    @Html.Partial("_Create", Model)
</div>


<div class="table-container">
    <table class="table table-bordered">
        <thead class="text-center">
            <tr>
                <th>Badge ID</th>
                <th>Name</th>
                <th>Windows Account</th>
                <th>Granted Access</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EmpBadgeId</td>
                    <td>@item.EmpName</td>
                    <td>@item.WindAcc</td>
                    <td>
                        <div class="row-cols-md-2">
                            @foreach (var option in ViewBag.AvailablePages as List<string>)
                            {
                                <label class="form-check-label">
                                    <input type="checkbox" class="form-check-input"
                                           @(item.PageAccessUsers.Any(p => p.PageName == option) ? "checked" : "") disabled />
                                    @option
                                </label>
                            }
                        </div>
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-primary btn-sm", style = "background-color: #0A8276;" })
                        <button class="btn btn-danger btn-sm deletebtn" data-id="@item.Id">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
    //get values
    function AutoRefresh() {
        $.get("@Url.Action("GetFormData", "Credentials")", function (data) {
            console.log("data :", GetFormData);
            $("#CredentialsData").html(data);
        });
    };

    /*GET AND FILL*/
        $(document).ready(function () {
        // Attach change event to the #EmpBadgeId element
        $("#EmpBadgeId").on("change", function () {
            var empBadgeId = $(this).val(); // Get the badge ID
            console.log("Sending EmpBadgeId:", empBadgeId);

            // Proceed only if the badge ID is valid (not empty)
            if (empBadgeId) {
                // Use Url.Action to dynamically generate the server endpoint
                var endpointUrl = '@Url.Action("GetCredsData", "Credentials")';

                // Make an AJAX GET request to fetch employee data
                $.ajax({
                    url: `${endpointUrl}?empBadgeId=${empBadgeId}`, // Append the badge ID as a query parameter
                    type: 'GET',
                    success: function (data) {
                        console.log("Response:", data);

                        // Check if data is returned
                        if (data) {
                            // Populate the input fields with the employee data
                            $('input[name="EmpName"]').val(data.EmpName);
                            $('input[name="WindAcc"]').val(data.WindAcc);

                            // Log values for debugging
                            console.log("Name input value after setting:", $('input[name="EmpName"]').val());
                            console.log("Windows input value after setting:", $('input[name="WindAcc"]').val());
                        } else {
                            console.log("No data received or employee not found.");
                            alert("No data available for the provided Employee Badge ID.");
                        }
                    },
                    error: function (xhr, status, error) {
                        // Handle errors gracefully
                        console.error("Error fetching employee data:", status, error);
                        alert("An error occurred while fetching employee data. Please try again.");
                    }
                });
            } else {
                console.log("No EmpBadgeId provided.");
                alert("Please enter a valid Employee Badge ID.");
            }
        });
    });

