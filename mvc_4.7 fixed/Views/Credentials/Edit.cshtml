
@model ok1.Models.Credential

@{
    ViewBag.Title = "Granted Access";
    var grantedCredentials = ViewBag.GrantedCredentials as List<string> ?? new List<string>();
}

<h2>@ViewBag.Title</h2>
<hr />


@using (Html.BeginForm("Edit", "Credentials", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="default-form">

        <div class="form-container">
            <div class="form-group">
                <label>Badge ID :</label>
                @Html.TextBoxFor(model => model.EmpBadgeId, new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Full Name :</label>
                @Html.TextBoxFor(model => model.EmpName, new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Windows Account : </label>
                @Html.TextBoxFor(model => model.WindAcc, new { @class = "form-control" })
            </div>
            <div class="form-group mb-3">
                <label class="form-label">Grant Access Pages :</label>
                <div class="row">
                    @foreach (var page in ViewBag.AvailablePages as List<string>)
                    {
                        <div class="row-cols-md-2">
                            <div class="form-check">
                                <input type="checkbox" name="SelectedPages" value="@page" class="form-check-input" id="page_@page"
                                       @(ViewBag.GrantedCredentials != null && ((List<string>)ViewBag.GrantedCredentials).Contains(page) ? "checked" : "") />
                                <label class="form-check-label" for="page_@page">@page</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="button-container">
            <input type="submit" value="Save changes" class="btn btn-primary" style="background-color: #0A8276;" />
            @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-back" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
