@{
    bool isPrivilegedUser = ViewBag.IsPrivilegedUser != null && (bool)ViewBag.IsPrivilegedUser;
}
<div class="row">
    <div class="col-12">
        <!-- Single Form for All Filters -->
        <form id="formFilter" method="get" @Url.Action("Index", "Users")>
            <div class="row">
                <!-- Filter by Date -->
                <div class="col-md-4">
                    <div class="filter-container">
                        <div class="form-group">
                            <label>From:</label>
                            <input type="date" class="form-control" name="from" value="@ViewBag.startDate" />
                            <label>To:</label>
                            <input type="date" class="form-control" name="to" value="@ViewBag.endDate" />
                        </div>
                    </div>
                </div>
                <!-- Filter by Badge ID -->
                <div class="col-md-4">
                    <div class="filter-container">
                        <div class="form-group">
                            <label>
                                Search Badge ID:
                                @if (!isPrivilegedUser)
                                {
                                    <small style="color:#0A8276; font-style:italic;">
                                        &#128268; Scan only
                                    </small>
                                }
                            </label>
                            @if (isPrivilegedUser)
                            {
                                <input type="text"
                                       class="form-control"
                                       id="searchString"
                                       name="searchString"
                                       value="@ViewBag.searchString"
                                       placeholder="Type Badge ID here"
                                       autocomplete="off" />
                            }
                            else
                            {
                                <!-- Hidden field yang dikirim ke server -->
                                <input type="hidden"
                                       id="searchString"
                                       name="searchString"
                                       value="@ViewBag.searchString" />
                                <!-- Display field - hanya untuk tampilan & scan -->
                                <input type="text"
                                       class="form-control"
                                       id="searchStringDisplay"
                                       value="@ViewBag.searchString"
                                       placeholder="Scan badge here..."
                                       autocomplete="off"
                                       inputmode="none"
                                       readonly
                                       style="background-color:#f0fffe; border: 1.5px solid #0A8276; caret-color: transparent;" />
                            }
                        </div>
                        <div class="form-group">
                            <label>Status:</label>
                            <select id="statusFilter" name="statusFilter" class="form-select">
                                <option value="all" @(ViewBag.StatusFilter == null || ViewBag.StatusFilter == "all" ? "selected" : "")>All</option>
                                <option value="failed" @(ViewBag.StatusFilter == "failed" ? "selected" : "")>Failed</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="filter-container">
                        <div class="form-group">
                            <label>Select Group:</label>
                            @Html.DropDownList("grpFilter", (SelectList)ViewBag.grpList, "Select Group", new { @class = "form-select", id = "grpFilter" })
                            <label>Select Area:</label>
                            @Html.DropDownList("areaFilter", (SelectList)ViewBag.areaList, "Select Area", new { @class = "form-select", id = "areaFilter" })
                            <label>Select Area Details:</label>
                            @Html.DropDownList("areaDIFilter", (SelectList)ViewBag.areaDIList, "Select Area Detail", new { @class = "form-select", id = "areaDIFilter" })
                            <label>Shift:</label>
                            @Html.DropDownList("shiftFilter", (SelectList)ViewBag.shiftList, "Select Shift", new { @class = "form-select", id = "shiftFilter" })
                        </div>
                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary" style="background-color: #0A8276;">Filter</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>