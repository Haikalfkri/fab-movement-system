<div class="row">
    <div class="col-12">
        <form id="formFilter" method="get" asp-action="RepeatedViolations">
            <div class="row">
                <!-- Filter by logweek -->
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Select LogWeek:</label>
                        @Html.DropDownList(
                            "logWeek",
                            new SelectList(ViewBag.LogWeeks as List<string>, ViewBag.SelectedLogWeek as string),
                            "Select LogWeek",
                            new { @class = "form-control", id = "logWeek" }
                        )
                    </div>
                </div>
                <!-- Filter by Badge ID -->
                <div class="col-md-4">
                    <div class="filter-container">
                        <div class="form-group">
                            <label>Search Badge ID:</label>
                            <input type="text" class="form-control" id="searchString" name="searchString" value="@ViewBag.searchString" placeholder="Type Badge ID here" />
                        </div>
                    </div>
                </div>
                <!-- Filter by Area -->
                <div class="col-md-4">
                    <div class="filter-container">
                        <div class="form-group">
                            <label>Select Area:</label>
                             @Html.DropDownList("areaFilter", (SelectList)ViewBag.areaList, "Select Area", new { @class = "form-select", id = "areaFilter" }) 
                        </div>
                        <button type="submit" class="btn btn-primary" style="background-color: #0A8276;">Filter</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>